# Texto portable y serialización YAML de Unity
* text=auto
*.cs text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.shader text eol=lf
*.uxml text eol=lf
*.uss text eol=lf

# Binarios comunes. Los recursos pequeños pueden usar Git normal.
*.blend binary
*.fbx binary
*.psd binary
*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.ogg binary
*.mp4 binary

# Git LFS se habilita por archivo, antes del primer commit del binario.
# Tras acordarlo: git lfs track --filename "Assets/Art/ruta/al/archivo.fbx"
# Versionar el cambio de este archivo junto al binario. Mantener los .meta en Git normal.
